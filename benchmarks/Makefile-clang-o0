clean:
	# rm -f ./m.h
	# rm -f ./gc.c
	# rm -f ./gc.h
	# rm -f ./gc_stack.c
	# rm -f ./gc_stack.h
	# rm -f ./values.h
	rm -f ./main.c
	# rm -f ./config.h
	rm -f ./*.*.c
	rm -f ./*.*.h
	rm -f ./glue.*.*.c
	rm -f ./glue.*.*.h
	rm -f ./glue_*.h
	rm -f ./glue_*.c
	rm -f ./*.vo
	rm -f ./*.vos
	rm -f ./*.vok
	rm -f ./*.glob
	rm -f ${EXEC}

cleanexec:
	rm -f $(EXEC)

lib/Makefile:
	cd lib; coq_makefile -f _CoqProject -o Makefile

lib: lib/Makefile
	$(MAKE) -C lib

cleanlib:
	$(MAKE) clean -C lib

tests: tests.v
	coqc $(COQOPTS) tests.v

## Compile with the default C compiler
$(TESTS): $(CFILES)
	$(CCOMPILER) -o $@ 			-w -Wno-everything -fomit-frame-pointer -I$(INCLUDE) $@_main.c $(INCLUDE)/gc_stack.c CertiCoq.Benchmarks.tests.$@.c glue_$@.c
	$(CCOMPILER) -o $@_opt 		-w -Wno-everything -fomit-frame-pointer -I$(INCLUDE) $@_main.c $(INCLUDE)/gc_stack.c CertiCoq.Benchmarks.tests.$@_opt.c glue_$@.c
	$(CCOMPILER) -o $@_opt_ll 	-w -Wno-everything -fomit-frame-pointer -I$(INCLUDE) $@_main.c $(INCLUDE)/gc_stack.c CertiCoq.Benchmarks.tests.$@_opt_ll.c glue_$@.c

run: run-clang.sh
	sh run-clang.sh
